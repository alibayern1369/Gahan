# ============================================================
# گاهان — Environment Variables
# ------------------------------------------------------------
# دو دسته متغیر داریم:
#  1) NEXT_PUBLIC_*  → امن برای مرورگر (در باندل فرانت‌اند قرار می‌گیرد)
#  2) بدون NEXT_PUBLIC → محرمانه و فقط سمت سرور (هرگز به مرورگر نمی‌رود)
#
# مقادیر واقعی را در فایل .env.local محلی یا در Vercel وارد کنید.
# هرگز این فایل را با مقادیر واقعی کامیت نکنید!
# ============================================================

# --- از داشبورد Supabase → Project Settings → API ---
# آدرس پروژه (امن برای مرورگر)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# کلید عمومی anon (امن برای مرورگر؛ با RLS محافظت می‌شود)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- محرمانه — فقط سمت سرور ---
# Service Role Key (دسترسی کامل؛ فقط روی سرور استفاده شود!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- محرمانه — برای محافظت از endpoint پاک‌سازی عکس‌ها (/api/cron/cleanup) ---
# یک رشته تصادفی طولانی بسازید؛ Vercel Cron خودکار ارسال می‌کند
CRON_SECRET=generate-a-long-random-secret

# --- اختیاری: برای اسکریپت داده نمونه (seed) ---
# npm run db:seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123456
ALLOW_DEMO_SEED=true
